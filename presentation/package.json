{
  "name": "apigee-architecture-lab-presentation",
  "version": "1.0.0",
  "private": true,
  "description": "Apresentação técnica do laboratório Google Cloud Apigee",
  "type": "module",
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/generate-speaker-script.mjs --check && node scripts/build.mjs",
    "generate:speaker-script": "node scripts/generate-speaker-script.mjs",
    "validate": "node scripts/generate-speaker-script.mjs --check && node scripts/validate.mjs",
    "validate:mermaid": "node scripts/validate-mermaid.mjs",
    "validate:visual": "node scripts/visual-check.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "reveal.js": "6.0.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0"
  }
}
