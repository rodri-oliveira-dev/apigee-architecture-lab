<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="orders-advanced">
  <DisplayName>Orders Advanced</DisplayName>
  <Description>Orders proxy demonstrating JWT, shared flows and fault handling.</Description>
  <Policies>
    <Policy>assign-auth-fault</Policy>
    <Policy>assign-default-fault</Policy>
    <Policy>call-shared-security</Policy>
    <Policy>verify-jwt</Policy>
  </Policies>
  <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>
  <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>
</APIProxy>
