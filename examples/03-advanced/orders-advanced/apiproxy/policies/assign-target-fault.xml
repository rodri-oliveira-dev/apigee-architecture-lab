<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="assign-target-fault" continueOnError="false" enabled="true">
  <DisplayName>Assign Safe Target Fault</DisplayName>
  <Set>
    <Headers><Header name="Content-Type">application/json</Header></Headers>
