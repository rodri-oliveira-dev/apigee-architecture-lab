<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="assign-default-fault" continueOnError="false" enabled="true">
  <DisplayName>Assign Safe Default Fault</DisplayName>
  <Set>
    <Headers><Header name="Content-Type">application/json</Header></Headers>
