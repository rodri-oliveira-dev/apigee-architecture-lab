<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description>JWT-protected proxy that delegates common controls to a shared flow.</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>verify-jwt</Name></Step>
      <Step><Name>call-shared-security</Name></Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="read-order">
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/**") and (request.verb = "GET")</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow"><Request/><Response/></PostFlow>
  <HTTPProxyConnection><BasePath>/lab/v1/orders-advanced</BasePath></HTTPProxyConnection>
  <FaultRules>
    <FaultRule name="jwt-fault">
      <Step><Name>assign-auth-fault</Name></Step>
      <Condition>JWT.failed = true</Condition>
    </FaultRule>
  </FaultRules>
  <DefaultFaultRule name="default-fault">
    <Step><Name>assign-default-fault</Name></Step>
  </DefaultFaultRule>
  <RouteRule name="default-route"><TargetEndpoint>default</TargetEndpoint></RouteRule>
</ProxyEndpoint>
