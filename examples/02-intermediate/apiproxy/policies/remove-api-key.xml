<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="remove-api-key" continueOnError="false" enabled="true">
  <DisplayName>Remove API Key Before Routing</DisplayName>
  <Remove>
    <Headers>
      <Header name="x-api-key"/>
    </Headers>
  </Remove>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
